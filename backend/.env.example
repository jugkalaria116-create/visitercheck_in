# --- Application ---
APP_ENV=production            # local | production
APP_URL=http://localhost:8000 # where this PHP app is served
FRONTEND_URL=http://localhost:8000  # public URL of the React app (same as APP_URL when PHP serves the build)
APP_TIMEZONE=Asia/Kolkata

# --- MongoDB (the only database) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=visitor_management

# --- Sessions ---
SESSION_SECURE_COOKIE=false   # set true in production (HTTPS only)

# --- Uploads / retention ---
UPLOAD_MAX_SIZE=8388608       # bytes per image (8 MB)
VISITOR_RETENTION_DAYS=90     # default; admin can change in Settings. 0 = keep forever
# STORAGE_PATH=C:/xampp/visitor-storage   # optional; default is backend/storage
